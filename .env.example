# Copy to your shell or hosting dashboard. Never commit real values.
PORT=8000
HOST=127.0.0.1                 # 0.0.0.0 to let other devices on the network connect
RIGHTCALL_DB=./rightcall.db
RIGHTCALL_CONTROL_KEY=         # set on any shared/public deployment; open /?key=<value> once to unlock a browser
RIGHTCALL_TRUST_PROXY=0        # 1 when behind a hosting proxy (Render, Fly, nginx)
GROQ_API_KEY=                  # optional LLM extraction; the app works without it
OPEN_METEO_URL=                # optional override for the weather endpoint
